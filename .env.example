# EcoTrace Server Configuration
PORT=3000

# ============================================================
# Google Gemini API Configuration (EcoTrace AI Assistant)
# ============================================================
# Get your official Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
# Required for the EcoTrace AI Assistant conversational chatbot.
# If left blank, EcoTrace core features remain 100% operational, and
# the AI Assistant interface will display a friendly setup configuration guide.
GEMINI_API_KEY=

# Server-controlled Gemini Model for EcoTrace AI Assistant
# Supported options: gemini-flash-latest (recommended), gemini-3.8-flash
GEMINI_MODEL=gemini-flash-latest

# Optional legacy key alias for cloud vision
VISION_API_KEY=

# ============================================================
# AI Waste Scanner Configuration
# ============================================================
# Confidence threshold (0.10 - 0.99) below which scans enter the Human Verification workflow
CONFIDENCE_THRESHOLD=0.75

# Local Computer Vision Model (runs via @xenova/transformers ONNX runtime without external API keys)
LOCAL_VISION_MODEL=Xenova/clip-vit-base-patch32
